# OfferPilot ECS 运行时配置模板。
#
# 用法：复制为 /root/offerpilot/.env 并填入真实值，然后 chmod 600 .env。
#   cp .env.template .env && vi .env && chmod 600 .env
#
# 该文件同时承担两个角色：
#   1) docker compose 的变量插值（ACR_* / OFFERPILOT_TAG）
#   2) 两个容器的运行时环境变量（compose 里 env_file: .env）
# 绝不能提交到 git，也绝不能打进镜像。

# --- 镜像来源（compose 变量插值用） ---
ACR_REGISTRY=registry.cn-beijing.aliyuncs.com
ACR_NAMESPACE=
OFFERPILOT_TAG=latest

# --- 服务端保护 ---
# web(BFF) 与 api 共用的内部 token。生成：openssl rand -hex 32
OFFERPILOT_API_KEY=
# 浏览器直连 api 时的 CORS 白名单（一般走 BFF，不需要改）
OFFERPILOT_ALLOWED_ORIGINS=http://60.205.125.130:3000

# --- 文本模型（OpenAI 兼容，必填）---
# 未配置时 /health/ready 返回 503，api 容器健康检查失败，web 不会启动。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.ai.tosky.top/v1
OPENAI_MODEL=gpt-5.5

# --- MiMo 语音（ASR/TTS，语音功能需要）---
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_ASR_MODEL=mimo-v2.5-asr
MIMO_TTS_MODEL=mimo-v2.5-tts
MIMO_TTS_VOICE=mimo_default
MIMO_ASR_LANGUAGE=auto
